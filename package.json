{
  "name": "trackd-co-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "//dev": "BIND to loopback, VISIT via localhost. The trap that 'the app does not hydrate on 127.0.0.1' is about the URL you OPEN, not the address the server binds. Verified 2026-08-17: with -H 127.0.0.1 the server listens on loopback only (closing the all-interfaces exposure) and http://localhost:3100 still answers 200 and hydrates. Do not 'fix' this back to a public bind; drive on http://localhost:3100, never http://127.0.0.1:3100.",
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "seed:compounds": "node supabase/seed/build-compounds-data.mjs",
    "prebuild": "node supabase/seed/build-compounds-data.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "reconcile": "node scripts/reconcile.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate:check": "node scripts/gate-audit.mjs --check",
    "check": "tsc --noEmit && eslint && npm run gate:check && vitest run"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.13.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@types/web-push": "^3.6.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.7",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
