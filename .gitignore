# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# (no trailing slash, so a `.next` SYMLINK to an off-iCloud cache is ignored too)
/.next
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase CLI local state (e.g. the linked-project file)
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Dev cache symlinked from .next, kept off iCloud (ends in .nosync)
.next.nosync

# A friend's trading-bot market data. Nothing to do with Trackd — it lives here
# only so Adrian still has it to hand. Kept OUT of git deliberately: it is 7 MB
# of CSV that was once committed by accident, and adding a .gitignore rule does
# NOT untrack an already-committed file (that took a `git rm --cached` to undo).
# Do not remove these rules without knowing that.
/trading data/
condensed_GLBX-*

# iCloud's conflicted-copy duplicates. Syncing this folder through iCloud Drive
# leaves a "<name> 2.<ext>" beside a file it thinks diverged — 102 appeared in a
# single session. They are byte-copies of tracked files, never edited, and
# committing them both doubles the repo and confuses git's rename detection
# (it starts pairing real files with the copies). Delete them freely.
* 2.*
* 2

# The verification harness. Rebuilt per session, drives PRODUCTION Supabase and
# real Stripe, and holds nothing worth keeping between sessions.
/scratchpad/
